# brand base connect. Copy to .env and fill in. The server refuses to start while a required
# value is missing. Never commit .env.

# Optional. Port the server listens on.
PORT=3010

# Public origin of this service. Each platform's redirect URI is
# ${PUBLIC_BASE_URL}/callback/{meta|pinterest|tiktok}. TikTok accepts only https.
PUBLIC_BASE_URL=http://localhost:3010

# 32 random bytes, base64. Encrypts stored tokens and seals OAuth state. Make one with:
#   openssl rand -base64 32
# Losing or changing it makes every stored token unreadable: everyone must connect again.
TOKEN_ENCRYPTION_KEY=

# Optional. Folder for the PGlite database. Default: .data/connect
DATABASE_PATH=.data/connect

# Meta app (developers.facebook.com), Facebook Login for Business.
# META_CONFIG_ID is the Login for Business configuration that lists the permissions.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# Pinterest app (developers.pinterest.com, My apps).
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# TikTok app (developers.tiktok.com), Login Kit. TikTok calls the app id a client key.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
