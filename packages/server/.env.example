# The BrandBase API. Every variable is read and checked by src/env.ts; the server stops at
# startup naming each bad one. With nothing set it runs locally on PGlite with dev sign-in.

# PORT=3001
# PUBLIC_URL=http://localhost:3001            # the address media links are handed out under
# CORS_ALLOWED_ORIGINS=http://localhost:3002  # the web app, when it runs on another origin

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Unset: PGlite in PGLITE_DIR. Set: a deployment (dev sign-in, disk storage, PIN_NOW and the
# development signing secret are then refused, and the job runner stays off).
# On Supabase use the transaction pooler, port 6543.
# DATABASE_URL=
# DATABASE_POOL_MAX=5
# PGLITE_DIR=.data/pglite

# ── Sign-in ───────────────────────────────────────────────────────────────────────────────
# AUTH_PROVIDER=dev                           # dev: the bearer token is the user id
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# ── Files ─────────────────────────────────────────────────────────────────────────────────
# STORAGE_PROVIDER=disk                       # disk: files under BLOB_DIR, served by this API
# BLOB_DIR=.data/blobs
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=brandbase
# MEDIA_SIGNING_SECRET=                       # openssl rand -base64 32; required in a deployment

# ── Local runs ────────────────────────────────────────────────────────────────────────────
# PIN_NOW=2026-10-06T04:00:00Z                # the demo's "today", so the API agrees with it
# JOB_INTERVAL_S=15
