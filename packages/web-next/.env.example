# Where the app gets its data. Defaults to `mock`, which answers every request from the
# fixtures in `src/fixtures/` via `src/lib/api/mock.ts` — no backend needed, and nothing is
# stored. Set to `live` to send real requests to NEXT_PUBLIC_API_URL instead.
#
# This app was adopted from the Operations Hub without its FastAPI backend, so `mock` is the
# only mode that currently renders anything. `live` is kept because the swap point is one
# function and removing it would be harder to put back than to leave.
NEXT_PUBLIC_API_MODE=mock

# Only read when NEXT_PUBLIC_API_MODE=live.
#
# Public by design: this is read in the browser, so never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only needed against a backend that gates on a shared token. NEXT_PUBLIC_ means it ships in
# the JS bundle — a gate against the open internet, not a secret from users of this app.
NEXT_PUBLIC_API_TOKEN=
