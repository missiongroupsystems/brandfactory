# Unset, the demo runs on its static data with no server (what Vercel deploys today).
# Set, every page loads from and writes to the core (packages/core, the brandbase pack);
# packs/brandbase/demo/web.sh starts one on :3013 with the demo's data.
# NEXT_PUBLIC_CORE_URL=http://localhost:3013

# Sign-in through Supabase. Unset, the sign-in page asks for a user id (the core's dev sign-in).
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
