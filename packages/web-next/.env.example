# Unset, the demo runs on its static data with no server (what Vercel deploys today).
# Set, every page loads from and writes to the BrandBase API (packages/server).
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Sign-in through Supabase. Unset, the sign-in page asks for a user id (the API's dev sign-in).
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
