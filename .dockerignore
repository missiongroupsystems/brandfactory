# The build context of `packages/core/Dockerfile` and `packages/bubbles/Dockerfile` is the repo
# root. Each Dockerfile copies only what its service needs; this keeps host installs, secrets
# and noise out of the context.
node_modules
**/node_modules
.env
.env.*
!.env.example
**/.next
**/.data
coverage
*.tsbuildinfo
.git
.github
.husky
.claude
docs
**/*.test.ts
**/*.test.tsx
# The other packages' sources are not part of the image; their manifests are, so the workspace
# install resolves. The connect package's source is: its host (src/brandbase/host.ts) is the
# server the image runs.
packages/web-next/*
!packages/web-next/package.json
packages/connect/*
!packages/connect/package.json
!packages/connect/src
!packages/connect/tsconfig.json
packs/brandbase/*
!packs/brandbase/package.json
# Bubbles' brief for the pack.
!packs/brandbase/bubbles.md
