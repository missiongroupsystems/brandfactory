# Applies to the repo-root build context used by packages/server/Dockerfile.
.git
node_modules
**/node_modules
**/dist
**/coverage

# Never bake env files into the image — runtime config comes from Fly secrets.
**/.env
**/.env.*
!**/.env.example

# Not needed to build or run the server.
docs
assets
.claude
*.md
fly.toml
