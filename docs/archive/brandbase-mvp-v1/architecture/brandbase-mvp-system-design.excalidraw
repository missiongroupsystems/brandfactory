ted": 1, "version": 1, "versionNonce": 1504004732, "verticalAlign": "top"}, {"id": "h1-n", "type": "ellipse", "x": 0, "y": 440, "width": 48, "height": 46, "angle": 0, "backgroundColor": "#299a8d", "boundElements": [{"id": "h1-n-t", "type": "text"}], "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0Y", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 2}, "seed": 2133201996, "strokeColor": "#299a8d", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1, "version": 1, "versionNonce": 1959386987}, {"id": "h1-n-t", "type": "text", "x": 18, "y": 450.5, "width": 12, "height": 25, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": [], "containerId": "h1-n", "fillStyle": "solid", "fontFamily": 1, "fontSize": 20, "frameId": null, "groupIds": [], "index": "b0Z", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "1", "roughness": 1, "roundness": null, "seed": 295334610, "strokeColor": "#ffffff", "strokeStyle": "solid", "strokeWidth": 2, "text": "1", "textAlign": "center", "updated": 1, "version": 1, "versionNonce": 401991736, "verticalAlign": "middle"}, {"id": "h1", "type": "text", "x": 62, "y": 444, "width": 216, "height": 37.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": [], "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 30, "frameId": null, "groupIds": [], "index": "b0a", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Requirements", "roughness": 1, "roundness": null, "seed": 1159380354, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "Requirements", "textAlign": "left", "updated": 1, "version": 1, "versionNonce": 2036236842, "verticalAlign": "top"}, {"id": "fr", "type": "text", "x": 0, "y": 505, "width": 792, "height": 275, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": [], "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 22, "frameId": null, "groupIds": [], "index": "b0b", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Functional\n1. One calendar for all brands: posts, shoots, campaigns\n2. Post plan with stages, Placeholder to Posted\n3. Weekly target per brand; warn when next month is short\n4. Share links: shoot brief (link or PDF), review\n5. Auto-publish IG + FB (phase 4); TikTok reminder\n   Brandwatch goes only once analytics are covered too\n6. Ideas: references, Pinterest, competitors, AI gap-filling\n7. Creators: directory, campaign pipeline, agency shortlist\n8. Brand guidelines become the AI's versioned context", "roughness": 1, "roundness": null, "seed": 279172787, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "Functional\n1. One calendar for all brands: posts, shoots, campaigns\n2. Post plan with stages, Placeholder to Posted\n3. Weekly target per brand; warn when next month is short\n4. Share links: shoot brief (link or PDF), review\n5. Auto-publish IG + FB (phase 4); TikTok reminder\n   Brandwatch goes only once analytics are covered too\n6. Ideas: references, Pinterest, competitors, AI gap-filling\n7. Creators: directory, campaign pipeline, agency shortlist\n8. Brand guidelines become the AI's versioned context", "textAlign": "left", "updated": 1, "version": 1, "versionNonce": 260573196, "verticalAlign": "top"}, {"id": "nfr", "type": "text", "x": 0, "y": 830, "width": 765.6, "height": 165, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": [], "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 22, "frameId": null, "groupIds": [], "index": "b0c", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Non-functional\n- Every AI call uses the brand context (cached, versioned)\n- One permission check on every read and write\n- Never double-post; failures show red + Slack\n- Every screen action is an API call (MCP later)\n- Workspaces, so outside clients can join later", "roughness": 1, "roundness": null, "seed": 1329753548, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "Non-functional\n- Every AI call uses the brand context (cached, versioned)\n- One permission check on every read and write\n- Never double-post; failures show red + Slack\n- Every screen action is an API call (MCP later)\n- Workspaces, so outside clients can join later", "textAlign": "left", "updated": 1, "version": 1, "versionNonce": 1914012529, "verticalAlign": "top"}, {"id": "scale", "type": "text", "x": 0, "y": 1030, "width": 765.6, "height": 55, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": [], "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 22, "frameId": null, "groupIds": [], "index": "b0d", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Assumed scale: ~15-30 posts/week, 2-4 users.\nOut of scope: TikTok API, IG saved posts, named approvers.", "roughness": 1, "roundness": null, "seed": 1222328496, "strokeColor": "#868e96", "strokeStyle": "solid", "strokeWidth": 2, "text": "Assumed scale: ~15-30 posts/week, 2-4 users.\nOut of scope: TikTok API, IG saved posts, named approvers.", "textAlign": "left", "updated": 1, "version": 1, "versionNonce": 1656961616, "verticalAlign": "top"}, {"id": "h2-n", "type": "ellipse", "x": 0, "y": 1160, "width": 48, "height": 46, "angle": 0, "backgroundColor": "#299a8d", "boundElements": [{"id": "h2-n-t", "type": "text"}], "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0e", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 2}, "seed": 1490376254, "strokeColor": "#299a8d", "strokeStyle": "solid", "strokeWidth": 2, "updat