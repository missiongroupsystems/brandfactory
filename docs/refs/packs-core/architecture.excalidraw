   "link": null,
   "locked": false,
   "text": "One server runs any app that is written as data: a pack.\nBrandBase is the first pack: brands, posts, the calendar, share links.\nScreens, guests and Bubbles, the AI agent, all call the same moves.\nA new app is new screens plus a new pack. No new server.",
   "originalText": "One server runs any app that is written as data: a pack.\nBrandBase is the first pack: brands, posts, the calendar, share links.\nScreens, guests and Bubbles, the AI agent, all call the same moves.\nA new app is new screens plus a new pack. No new server.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
