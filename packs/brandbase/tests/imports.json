          "now": "2026-10-07T04:00:00Z",
          "input": {
            "brand": "casa",
            "channel": "ig",
            "externalId": "DPx2",
            "format": "reel",
            "hook": "New hook",
            "caption": "New hook, edited on Instagram.",
            "at": "2026-09-01T10:00:00Z",
            "permalink": "https://www.instagram.com/reel/DPx2/",
            "media": [],
            "metrics": {
              "likes": 25,
              "views": 340
            }
          },
          "expect": {
            "result": {
              "id": "casa-ig-DPx2",
              "hook": "New hook",
              "caption": "New hook, edited on Instagram.",
