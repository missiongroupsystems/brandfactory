                {
                  "src": "/files/sig/brandbase/cover.jpg#photo"
                }
              ],
              "version": 2
            }
          }
        },
        {
          "sql": "select count(*)::int as n, (array_agg(metrics))[1] ->> 'views' as views from brandbase.posts where id = 'casa-ig-DPx2'",
