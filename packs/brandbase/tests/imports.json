                "permalink": null
              }
            ]
          }
        },
        {
          "call": "post.import",
          "input": {
            "brand": "temper",
            "channel": "ig",
            "externalId": "Shared",
            "format": "carousel",
            "hook": "Steak",
            "at": "2026-09-20T10:00:00Z",
            "permalink": "https://www.instagram.com/p/Shared/",
            "metrics": {
              "likes": 5
            }
          },
          "as": "b-owner"
        },
        {
          "call": "post.import",
          "input": {
            "brand": "casa",
            "channel": "ig",
            "externalId": "Shared",
            "format": "carousel",
            "hook": "Pasta",
            "at": "2026-09-20T10:00:00Z",
            "permalink": "https://www.instagram.com/p/Shared/",
            "metrics": {
              "likes": 7
            }
          },
          "expect": {
            "result": {
              "id": "casa-ig-Shared",
              "metrics": {
                "likes": 7
              }
            }
          }
        },
        {
          "sql": "select id, brand_id, metrics ->> 'likes' as likes from brandbase.posts where id like '%-ig-Shared' order by id",
          "expect": {
            "rows": [
              {
                "id": "casa-ig-Shared",
                "brand_id": "casa",
                "likes": "7"
              },
              {
                "id": "temper-ig-Shared",
                "brand_id": "temper",
                "likes": "5"
              }
            ]
          }
        }
      ]
