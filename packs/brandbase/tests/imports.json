    {
      "name": "keeps a post brought in final: no edit, move, mark or unplan changes it",
      "steps": [
        {
          "call": "post.import",
          "input": {
            "brand": "casa",
            "channel": "ig",
            "externalId": "DPx3",
            "format": "carousel",
            "hook": "Out already",
            "at": "2026-09-20T10:00:00Z",
            "permalink": "https://www.instagram.com/p/DPx3/",
            "metrics": {}
          }
        },
        {
          "call": "post.edit",
          "input": {
            "brand": "casa",
            "id": "casa-ig-DPx3",
            "caption": "changed"
          },
          "expect": {
            "status": 409,
            "code": "POST_POSTED"
          }
        },
        {
          "call": "post.mark",
          "input": {
            "brand": "casa",
            "id": "casa-ig-DPx3",
            "stage": "draft"
          },
          "expect": {
            "status": 409,
            "code": "POST_POSTED"
          }
        },
        {
          "call": "post.move",
          "input": {
            "brand": "casa",
            "id": "casa-ig-DPx3",
            "day": "2026-10-20"
          },
          "expect": {
            "status": 409,
            "code": "POST_POSTED"
          }
        },
        {
          "call": "post.unplan",
          "input": {
            "brand": "casa",
            "id": "casa-ig-DPx3"
          },
          "expect": {
            "status": 409,
            "code": "POST_POSTED"
          }
        }
      ]
    },
    {
      "name": "refuses an id a post BrandBase made holds, in this brand or another company's, and keeps the same post brought in by two brands apart",
      "steps": [
        {
          "call": "post.create_draft",
