      "name": "lets a company's owner add a brand with an empty kit, after the company's brands, seen at once by every member and by no one else",
      "steps": [
        {
          "call": "brand.create",
          "input": {
            "org": "co-a",
            "name": "Trattoria Roma",
            "handle": "@trattoria",
            "linked": ["ig", "tt"],
            "line": "Roman kitchen",
            "timezone": "Europe/Rome"
          },
          "expect": {
            "result": {
              "id": "trattoria-roma",
              "orgId": "co-a",
              "name": "Trattoria Roma",
              "handle": "@trattoria",
              "line": "Roman kitchen",
              "timezone": "Europe/Rome",
              "linked": ["ig", "tt"],
              "position": 3,
              "tiktokDefaults": null,
              "locations": [],
