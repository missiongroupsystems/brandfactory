          }
        },
        {
          "call": "brand.list",
          "as": "member",
          "input": {},
          "expect": {
            "length": 3,
            "result": [
              {
                "id": "casa"
              },
              {
                "id": "osteria"
              },
              {
                "id": "trattoria-roma"
              }
            ]
          }
        },
        {
          "call": "brand.list",
          "as": "both",
          "input": {},
          "expect": {
            "length": 4,
            "result": [
              {
                "id": "casa"
              },
              {
                "id": "osteria"
              },
              {
                "id": "trattoria-roma"
              },
              {
                "id": "temper"
              }
            ]
          }
        },
        {
