    {
      "name": "refuses a member a brand added past the move, and anyone a kit for another company's brand: the row rules and the kit's key alone guard them",
      "steps": [
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('member'); set local role pack_runtime; insert into brandbase.brands (id, org_id, name, handle) values ('direct', 'co-a', 'Direct', '@direct'); end $$",
          "expect": {
            "error": "new row violates row-level security policy"
          }
        },
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('both'); set local role pack_runtime; insert into brandbase.brands (id, org_id, name, handle) values ('direct', 'co-a', 'Direct', '@direct'); end $$",
          "expect": {
            "error": "new row violates row-level security policy"
          }
        },
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('owner'); set local role pack_runtime; insert into brandbase.brands (id, org_id, name, handle) values ('direct', 'co-b', 'Direct', '@direct'); end $$",
          "expect": {
            "error": "new row violates row-level security policy"
          }
        },
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('owner'); set local role pack_runtime; insert into brandbase.brands (id, org_id, name, handle) values ('direct', 'co-a', 'Direct', '@direct'); raise exception 'owner added %', (select count(*) from brandbase.brands where id = 'direct'); end $$",
          "expect": {
            "error": "owner added 1"
          }
        },
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('owner'); set local role pack_runtime; insert into brandbase.brand_kits (brand_id, org_id, voice, colours, logo) values ('temper', 'co-a', '{}', '[]', '{}'); end $$",
          "expect": {
            "error": "brand_kits_brand_org"
          }
        },
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('owner'); set local role pack_runtime; insert into brandbase.brand_kits (brand_id, org_id, voice, colours, logo) values ('temper', 'co-b', '{}', '[]', '{}'); end $$",
          "expect": {
            "error": "new row violates row-level security policy"
          }
        },
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('member'); set local role pack_runtime; insert into brandbase.brand_kits (brand_id, org_id, voice, colours, logo) values ('temper', 'co-a', '{}', '[]', '{}'); end $$",
          "expect": {
            "error": "new row violates row-level security policy"
          }
        },
        {
          "sql": "do $$ begin insert into claims.calls (user_id) values ('member'); set local role pack_runtime; update brandbase.brands set tiktok_defaults = '{}' where id = 'osteria'; raise exception 'member changed %', (select count(*) from brandbase.brands where tiktok_defaults is not null); end $$",
          "expect": {
            "error": "member changed 1"
          }
        }
      ]
