    {
      "name": "takes a post off the calendar and puts its idea back on the day, a suggestion still a suggestion",
      "steps": [
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00"
          }
        },
        {
          "sql": "update brandbase.posts set from_idea = '{\"why\": \"Built on the pasta reel\", \"suggested\": true}' where id = 'p1'"
        },
        {
          "sql": "insert into brandbase.ideas (id, brand_id, format, hook, status, post_id, why) values ('i1', 'casa', 'reel', 'Pasta night', 'idea', 'p1', 'old')"
        },
        {
          "call": "post.unplan",
          "input": {
            "brand": "casa",
            "id": "p1"
          },
          "expect": {
            "result": {
              "deleted": "p1",
              "idea": {
                "id": "i1",
                "postId": null,
                "day": "2026-10-08",
                "why": "Built on the pasta reel",
                "status": "suggested"
              }
            }
          }
        },
        {
          "call": "post.list",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "length": 0
          }
        }
