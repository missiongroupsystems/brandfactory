    {
      "name": "moves the jobs not yet sent with the post",
      "steps": [
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00"
          }
        },
        {
          "sql": "insert into brandbase.post_jobs (id, post_id, brand_id, channel, status, run_at) values ('j1', 'p1', 'casa', 'ig', 'scheduled', '2026-10-08T10:00:00Z')"
        },
        {
          "call": "post.move",
          "input": {
            "brand": "casa",
            "id": "p1",
            "day": "2026-10-09",
            "time": "19:30"
          },
          "expect": {
            "result": {
              "jobs": [
                {
                  "runAt": "2026-10-09T11:30:00.000Z"
                }
              ]
            }
          }
        },
        {
          "sql": "select brandbase.iso(run_at) as at from brandbase.post_jobs",
          "expect": {
            "rows": [
              {
                "at": "2026-10-09T11:30:00.000Z"
              }
            ]
          }
        }
      ]
    },
