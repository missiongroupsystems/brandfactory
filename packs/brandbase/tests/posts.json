{
  "name": "posts",
  "now": "2026-10-06T04:00:00Z",
  "as": "member",
  "cases": [
    {
      "name": "a post's stage comes from the jobs, and a hand mark only counts when no job exists",
      "steps": [
        {
          "sql": "select brandbase.stage(null, '{}') as a, brandbase.stage('scheduled', '{}') as b, brandbase.stage(null, '{live,scheduled}') as c, brandbase.stage(null, '{live,failed}') as d, brandbase.stage('scheduled', '{live,live}') as e",
          "expect": {
            "rows": [
              {
                "a": "draft",
                "b": "scheduled",
                "c": "scheduled",
                "d": "failed",
                "e": "posted"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "makes one post for a repeated id, since a double click sends twice",
      "steps": [
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00"
          },
          "expect": {
            "result": {
              "hook": "Pasta night"
            }
          }
        },
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Changed",
            "day": "2026-10-08",
            "time": "18:00"
          },
          "expect": {
            "result": {
              "hook": "Pasta night"
            }
          }
        },
        {
          "call": "post.list",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "length": 1
          }
        }
      ]
    },
    {
      "name": "refuses an id another brand holds, since posts are looked up by id alone",
      "steps": [
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00"
          },
          "as": "both",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "post.create_draft",
          "input": {
            "brand": "temper",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00"
          },
          "as": "both",
          "expect": {
            "status": 409,
            "code": "ID_TAKEN"
          }
        }
      ]
    },
