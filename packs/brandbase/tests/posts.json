    {
      "name": "moves the day and keeps the time",
      "steps": [
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00"
          }
        },
        {
          "call": "post.move",
          "input": {
            "brand": "casa",
            "id": "p1",
            "day": "2026-10-10"
          },
          "expect": {
            "result": {
              "day": "2026-10-10",
              "time": "18:00",
              "version": 2
            }
