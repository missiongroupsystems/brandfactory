    {
      "name": "lets one of two stories moved onto one day at once win",
      "steps": [
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "s1",
            "format": "story",
            "hook": "Story",
            "day": "2026-10-09",
            "time": "12:00"
          }
        },
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "s2",
            "format": "story",
            "hook": "Story",
            "day": "2026-10-10",
            "time": "12:00"
          }
        },
        {
          "parallel": [
            {
              "call": "post.move",
              "input": {
                "brand": "casa",
                "id": "s1",
                "day": "2026-10-12"
              }
            },
            {
              "call": "post.move",
              "input": {
                "brand": "casa",
                "id": "s2",
                "day": "2026-10-12"
              }
            }
          ],
          "expect": {
            "codes": [null, "STORY_TAKEN"]
          }
        },
        {
          "sql": "select count(*)::int as n from brandbase.posts where day = '2026-10-12'",
          "expect": {
            "rows": [
              {
                "n": 1
              }
            ]
          }
        }
      ]
