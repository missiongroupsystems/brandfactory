    {
      "name": "go out when due, and the post is posted once every account is live",
      "steps": [
        {
          "sql": "insert into brandbase.connections (brand_id, key, status) values ('casa', 'ig', 'connected'), ('casa', 'tt', 'connected')"
        },
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00",
            "caption": "Fresh pasta tonight.",
            "media": [
              {
                "src": "/videos/pasta.mp4",
                "kind": "video"
              }
            ],
            "draft": {
              "privacy": "Everyone",
              "promo": {
                "on": false
              }
            }
          }
        },
        {
          "call": "post.schedule",
          "input": {
            "brand": "casa",
            "id": "p1",
            "when": "slot"
          },
          "expect": {
            "result": {
              "jobs": [
                {
                  "channel": "ig",
                  "status": "scheduled"
                },
                {
                  "channel": "tt",
                  "status": "scheduled"
                }
              ]
            }
          }
        },
        {
          "approve": "post.publish_job",
          "input": {
            "brand": "casa",
            "job": "p1:ig"
          }
        },
        {
          "approve": "post.publish_job",
          "input": {
            "brand": "casa",
            "job": "p1:tt"
          }
        },
        {
          "tick": "run"
        },
        {
          "call": "post.list",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "result": [
              {
                "stage": "scheduled"
              }
            ]
          }
        },
        {
          "tick": "run",
          "now": "2026-10-08T10:00:00Z"
        },
        {
          "call": "post.list",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "result": [
              {
                "stage": "posted",
