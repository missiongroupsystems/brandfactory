    {
      "name": "links a sender with a live code once, and answers a message seen before as not fresh",
      "steps": [
        {
          "sql": "insert into brandbase.accounts (brand_id, platform, account_id, username, tokens, details, connected_by) values ('casa', 'instagram', '17841400000000001', 'casavostra', 'sealed', '{\"via\": \"meta\", \"pageId\": \"100000000000001\"}', 'owner')"
        },
        {
          "call": "capture.code",
          "as": "both",
          "input": {
            "account": "17841400000000001",
            "codeHash": "a00d76646eba91b057841554d5c8334f498dc592ed744bce404f21fe271cd36e"
          },
          "expect": {
            "result": {
              "expiresAt": "2026-10-06T04:10:00.000Z"
            }
          }
        },
        {
          "call": "capture.link",
          "as": "owner",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "mid": "mid-l0",
            "codeHash": "bb1ab0dd3aee0aa84716401792122e5ddbdec3b306cef3d54b359353c9fd3e07"
          },
          "expect": {
            "result": {
              "fresh": true,
              "linked": null,
              "limited": false
            }
          }
        },
        {
          "call": "capture.link",
          "as": "owner",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "mid": "mid-l1",
