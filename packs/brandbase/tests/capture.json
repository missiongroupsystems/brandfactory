{
  "name": "capture",
  "now": "2026-10-06T04:00:00Z",
  "as": "owner",
  "cases": [
    {
      "name": "claims a share once, saves it to the brand tapped once its copy is stored, as a reel added by its sender that opens on Instagram",
      "steps": [
        {
          "sql": "insert into brandbase.accounts (brand_id, platform, account_id, username, tokens, details, connected_by) values ('casa', 'instagram', '17841400000000001', 'casavostra', 'sealed', '{\"via\": \"meta\", \"pageId\": \"100000000000001\"}', 'owner')"
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-s1"
          },
          "expect": {
            "result": {
              "claimed": true,
              "lastBrand": null
            }
          }
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-s1"
          },
          "expect": {
            "result": {
              "claimed": false
            }
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "6001",
            "brand": "casa",
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "status": 404
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": "osteria",
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "result": {
              "saved": false,
              "brand": "osteria",
              "brandName": "Osteria",
              "stored": false
            }
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": null,
            "src": "https://core.example/files/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/brandbase/00000000-0000-4000-8000-000000000001.mp4",
            "kind": "video",
            "name": "Ana",
            "handle": "ana.cooks",
            "link": "https://www.instagram.com/reel/DAbc123xyz/"
          },
          "expect": {
            "result": {
              "saved": true,
              "stored": true
            }
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": "osteria",
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "result": {
              "saved": false
            }
          }
        },
        {
          "call": "brand.state",
          "as": "member",
          "input": {
            "brand": "osteria"
          },
          "expect": {
            "result": {
              "pasted": [
                {
                  "id": "meta-s1",
                  "platform": "ig",
                  "account": "@ana.cooks",
                  "addedBy": "@ana.cooks",
                  "link": "https://www.instagram.com/reel/DAbc123xyz/",
                  "image": "",
                  "video": "https://core.example/files/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/brandbase/00000000-0000-4000-8000-000000000001.mp4",
                  "borrow": "Shared reel",
                  "seed": {
                    "format": "reel"
                  }
                }
              ]
            }
          }
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-s2"
          },
          "expect": {
            "result": {
              "claimed": true,
              "lastBrand": "osteria"
            }
          }
        }
      ]
    },
    {
      "name": "a photo with no address on Instagram opens our copy, and a sender with no name shows as Instagram",
      "steps": [
        {
          "sql": "insert into brandbase.accounts (brand_id, platform, account_id, username, tokens, details, connected_by) values ('casa', 'instagram', '17841400000000001', 'casavostra', 'sealed', '{\"via\": \"meta\", \"pageId\": \"100000000000001\"}', 'owner')"
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-p1"
          },
          "expect": {}
        },
        {
          "call": "capture.file",
          "input": {
            "id": "meta-p1",
            "mime": "image/jpeg"
          },
          "expect": {
            "result": {
              "upload": {
                "headers": {
                  "content-type": "image/jpeg"
                }
              }
            }
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-p1",
            "sender": "5001",
            "brand": null,
            "src": "https://core.example/files/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/brandbase/00000000-0000-4000-8000-000000000002.jpg",
            "kind": "image",
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "result": {
              "saved": false,
              "stored": true
            }
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-p1",
            "sender": "5001",
            "brand": "casa",
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "result": {
              "saved": true,
              "brandName": "Casa Vostra"
            }
          }
        },
        {
          "call": "brand.state",
          "as": "member",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "result": {
              "pasted": [
                {
                  "id": "meta-p1",
                  "account": "Instagram",
                  "addedBy": null,
                  "link": "https://core.example/files/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/brandbase/00000000-0000-4000-8000-000000000002.jpg",
                  "image": "https://core.example/files/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/brandbase/00000000-0000-4000-8000-000000000002.jpg",
                  "video": null,
                  "seed": {
                    "format": "carousel"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "a capture account out of reach is refused as not found, and so is its capture and a brand out of reach",
      "steps": [
        {
          "sql": "insert into brandbase.accounts (brand_id, platform, account_id, username, tokens, details, connected_by) values ('casa', 'instagram', '17841400000000001', 'casavostra', 'sealed', '{\"via\": \"meta\", \"pageId\": \"100000000000001\"}', 'owner')"
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-s1"
          },
          "expect": {}
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-x"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          },
          "as": "b-owner"
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": "casa",
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND",
            "message": "capture not found"
          },
          "as": "b-owner"
        },
        {
          "call": "capture.file",
          "as": "b-owner",
          "input": {
            "id": "meta-s1",
            "mime": "video/mp4"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "capture.drop",
          "as": "b-owner",
          "input": {
            "id": "meta-s1"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": "temper",
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND",
            "message": "brand not found"
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": null,
            "src": "https://evil.example/x.mp4",
            "kind": "video",
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "status": 400
          }
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": null,
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": "https://evil.example/reel/x/"
          },
          "expect": {
            "status": 400
          }
        }
      ]
    },
    {
      "name": "a deleted message takes its capture and its pasted link with it",
      "steps": [
        {
          "sql": "insert into brandbase.accounts (brand_id, platform, account_id, username, tokens, details, connected_by) values ('casa', 'instagram', '17841400000000001', 'casavostra', 'sealed', '{\"via\": \"meta\", \"pageId\": \"100000000000001\"}', 'owner')"
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-s1"
          },
          "expect": {}
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": "casa",
            "src": "https://core.example/files/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/brandbase/00000000-0000-4000-8000-000000000001.mp4",
            "kind": "video",
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {
            "result": {
              "saved": true
            }
          }
        },
        {
          "call": "capture.drop",
          "input": {
            "id": "meta-s1"
          },
          "expect": {
            "result": {
              "dropped": 1,
              "pasted": 1
            }
          }
        },
        {
          "call": "capture.drop",
          "input": {
            "id": "meta-s1"
          },
          "expect": {
            "status": 404
          }
        },
        {
          "sql": "select count(*)::int as n from brandbase.pasted_links where id = 'meta-s1'",
          "expect": {
            "rows": [
              {
                "n": 0
              }
            ]
          }
        }
      ]
    },
    {
      "name": "forgetting the capture account forgets what it kept of its senders",
      "steps": [
        {
          "sql": "insert into brandbase.accounts (brand_id, platform, account_id, username, tokens, details, connected_by) values ('casa', 'instagram', '17841400000000001', 'casavostra', 'sealed', '{\"via\": \"meta\", \"pageId\": \"100000000000001\"}', 'owner')"
        },
        {
          "call": "capture.take",
          "input": {
            "account": "17841400000000001",
            "sender": "5001",
            "id": "meta-s1"
          },
          "expect": {}
        },
        {
          "call": "capture.save",
          "input": {
            "id": "meta-s1",
            "sender": "5001",
            "brand": "casa",
            "src": null,
            "kind": null,
            "name": null,
            "handle": null,
            "link": null
          },
          "expect": {}
        },
        {
          "call": "account.forget",
          "input": {
            "brand": "casa",
            "platform": "instagram",
            "accountId": "17841400000000001"
          },
          "expect": {
            "length": 1
          }
        },
        {
          "sql": "select count(*)::int as senders from brandbase.capture_senders",
          "expect": {
            "rows": [
              {
                "senders": 0
              }
            ]
          }
        }
      ]
