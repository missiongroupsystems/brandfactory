{
  "name": "collaborators",
  "now": "2026-11-01T04:00:00Z",
  "as": "member",
  "cases": [
    {
      "name": "saves the accounts a brand works with per platform, in the order they come, each once, for every member of its company",
      "steps": [
        {
          "call": "brand.state",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "result": {
              "brand": {
                "collaborators": {}
              }
            }
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "  @DanielFoodDiary "
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@danielfooddiary"]
              }
            }
          }
        },
        {
          "call": "brand.collaborator_add",
          "as": "owner",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "chefantonio"
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@danielfooddiary", "@chefantonio"]
              }
            }
          }
        },
        {
          "call": "brand.collaborator_add",
          "as": "both",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "DANIELFOODDIARY"
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@danielfooddiary", "@chefantonio"]
              }
            }
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "tt",
            "handle": "@danielfooddiary"
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@danielfooddiary", "@chefantonio"],
                "tt": ["@danielfooddiary"]
              }
            }
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "fb",
            "handle": " Eatbook   Singapore "
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@danielfooddiary", "@chefantonio"],
                "tt": ["@danielfooddiary"],
                "fb": ["Eatbook Singapore"]
              }
            }
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "fb",
            "handle": "eatbook singapore"
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@danielfooddiary", "@chefantonio"],
                "tt": ["@danielfooddiary"],
                "fb": ["Eatbook Singapore"]
              }
            }
          }
        },
        {
          "call": "brand.state",
          "as": "both",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "result": {
              "brand": {
                "collaborators": {
                  "ig": ["@danielfooddiary", "@chefantonio"],
                  "tt": ["@danielfooddiary"],
                  "fb": ["Eatbook Singapore"]
                }
              }
            }
          }
        },
        {
          "call": "brand.state",
          "as": "owner",
          "input": {
            "brand": "osteria"
          },
          "expect": {
            "result": {
              "brand": {
                "collaborators": {}
              }
            }
          }
        }
      ]
    },
    {
      "name": "removes an account from one platform whatever its case, keeps the others in order, and changes nothing for one it does not have",
      "steps": [
        {
          "sql": "update brandbase.brands set collaborators = '{\"ig\": [\"@a\", \"@b\", \"@c\"], \"tt\": [\"@b\"]}' where id = 'casa'"
        },
        {
          "call": "brand.collaborator_drop",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "@B"
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@a", "@c"],
                "tt": ["@b"]
              }
            }
          }
        },
        {
          "call": "brand.collaborator_drop",
          "as": "owner",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "@b"
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@a", "@c"],
                "tt": ["@b"]
              }
            }
          }
        },
        {
          "call": "brand.collaborator_drop",
          "input": {
            "brand": "casa",
            "platform": "fb",
            "handle": "Nobody"
          },
          "expect": {
            "result": {
              "collaborators": {
                "ig": ["@a", "@c"],
                "tt": ["@b"]
              }
            }
          }
        }
      ]
    },
    {
      "name": "refuses a blank or overlong handle, an Instagram or TikTok handle with other characters, and a platform it does not know",
      "steps": [
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": " @ "
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "@foo bar"
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "tt",
            "handle": "@a/b"
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "casa",
            "platform": "yt",
            "handle": "@someone"
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "call": "brand.state",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "result": {
              "brand": {
                "collaborators": {}
              }
            }
          }
        }
      ]
    },
    {
      "name": "lets no one outside the brand's company add or remove its collaborators",
      "steps": [
        {
          "sql": "update brandbase.brands set collaborators = '{\"ig\": [\"@joshua_raaj\"]}' where id = 'temper'"
        },
        {
          "call": "brand.collaborator_add",
          "input": {
            "brand": "temper",
            "platform": "ig",
            "handle": "@someone"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "brand.collaborator_drop",
          "input": {
            "brand": "temper",
            "platform": "ig",
            "handle": "@joshua_raaj"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "brand.collaborator_add",
          "as": "loner",
          "input": {
            "brand": "casa",
            "platform": "ig",
            "handle": "@someone"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "sql": "do $$ declare n int; begin insert into claims.calls (user_id) values ('member'); set local role pack_runtime; update brandbase.brands set collaborators = '{}' where id = 'temper'; get diagnostics n = row_count; raise exception 'member changed %', n; end $$",
          "expect": {
            "error": "member changed 0"
          }
        },
        {
          "sql": "select collaborators from brandbase.brands where id = 'temper'",
          "expect": {
            "rows": [
              {
                "collaborators": {
                  "ig": ["@joshua_raaj"]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
