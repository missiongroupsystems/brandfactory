    {
      "name": "answers a suggestion with the picks in the order given and saves nothing to the idea",
      "steps": [
        {
          "call": "idea.create",
          "input": {
            "brand": "casa",
            "id": "i1",
            "format": "reel",
            "hook": "Nonna rolls the pasta",
            "image": "/photos/pasta.jpg",
            "inspiration": ["casa-s1"]
          }
        },
        {
          "call": "moodboard.suggest",
          "input": {
            "brand": "casa",
            "idea": "i1",
            "picks": ["casa-p-late", "casa-s1"],
            "why": "Candlelight suits it"
          },
          "expect": {
            "result": {
              "idea": {
                "id": "i1",
                "hook": "Nonna rolls the pasta",
                "inspiration": ["casa-s1"]
              },
              "picks": ["casa-p-late", "casa-s1"]
            }
          }
        },
        {
          "call": "brand.state",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "result": {
              "ideas": [
                {
                  "id": "i1",
                  "version": 1,
                  "inspiration": ["casa-s1"]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "takes a pasted link as a pick, with no idea",
      "steps": [
        {
          "call": "pasted.add",
          "now": "2026-10-06T04:00:00Z",
          "input": {
            "brand": "casa",
            "id": "l-new",
            "platform": "ig",
            "account": "@pasted",
            "image": "",
            "borrow": "b",
            "seed": {
              "format": "reel",
              "pillar": "",
              "hook": "Pasted l-new",
              "angle": "",
              "feature": "",
              "shots": [],
              "sharper": []
            }
          }
        },
        {
          "call": "moodboard.suggest",
          "input": {
            "brand": "casa",
            "picks": ["l-new"]
          },
          "expect": {
            "result": {
              "idea": null,
              "picks": ["l-new"]
            }
          }
        }
      ]
    },
    {
      "name": "refuses an unknown key and another brand's post, naming them",
      "steps": [
        {
          "call": "moodboard.suggest",
          "input": {
            "brand": "casa",
            "picks": ["temper-s1", "casa-s1", "nope"]
          },
          "expect": {
            "status": 400,
            "code": "BAD_POST",
            "details": ["temper-s1", "nope"]
          }
        }
      ]
    },
    {
      "name": "refuses another brand's idea as not found",
      "steps": [
        {
          "call": "idea.create",
          "as": "admin",
          "input": {
            "brand": "temper",
            "id": "t-idea",
            "format": "reel",
            "hook": "Steak",
            "image": "/s.jpg"
          }
        },
        {
          "call": "moodboard.suggest",
          "input": {
            "brand": "casa",
            "idea": "t-idea",
            "picks": ["casa-s1"]
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "moodboard.suggest",
          "input": {
            "brand": "casa",
            "idea": "no-idea",
            "picks": ["casa-s1"]
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        }
      ]
    },
    {
      "name": "lets the runtime role read the moodboard tables and write neither",
      "steps": [
        {
          "sql": "select has_table_privilege('pack_runtime', 'brandbase.moodboard_boards', 'select') as boards, has_table_privilege('pack_runtime', 'brandbase.moodboard_posts', 'select') as posts, has_table_privilege('pack_runtime', 'brandbase.moodboard_posts', 'insert, update, delete') as writes",
          "expect": {
            "rows": [
              {
                "boards": true,
                "posts": true,
                "writes": false
              }
            ]
          }
        },
        {
          "call": "moodboard.list",
          "input": {
            "brand": "casa"
          },
          "expect": {
            "length": 4
          }
        }
      ]
