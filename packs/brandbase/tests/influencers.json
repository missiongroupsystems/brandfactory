        {
          "sql": "select i.name, i.status, i.notes, a.position, a.platform, a.handle, a.followers::int from brandbase.influencers i join brandbase.influencer_accounts a on a.influencer_id = i.id where i.slug = 'lee-ann-ong' order by a.position",
          "expect": {
            "rows": [
              {
                "name": "Lee Ann Ong",
                "status": "active",
                "notes": "",
                "position": 0,
                "platform": "instagram",
                "handle": "leeann.eats",
                "followers": 36600
