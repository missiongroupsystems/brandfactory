                "followers": 100
              },
              {
                "platform": "instagram",
                "handle": "ana.cooks",
                "followers": 1
              }
            ]
          },
          "expect": {
            "result": {
              "made": false,
              "accounts": 2
            }
          }
        },
        {
          "sql": "select i.status, i.notes, a.position, a.platform, a.handle, a.followers::int, a.engagement::float as engagement from brandbase.influencers i join brandbase.influencer_accounts a on a.influencer_id = i.id where i.slug = 'lee-ann-ong' order by a.position",
          "expect": {
            "rows": [
