    {
      "name": "an owner or admin imports people by slug and accounts by handle; a second run adds nothing, and update writes what it is given",
      "steps": [
        {
          "call": "influencer.import",
          "as": "owner",
          "input": {
            "org": "co-a",
            "slug": "lee-ann-ong",
            "name": "Lee Ann Ong",
            "category": "food",
            "status": "active",
            "accounts": [
              {
                "platform": "instagram",
                "handle": " @LeeAnn.Eats ",
                "followers": 36600
              },
              {
                "platform": "tiktok",
                "handle": "leeann.eats",
                "followers": 2791
              }
            ]
          },
          "expect": {
            "result": {
              "slug": "lee-ann-ong",
              "made": true,
              "accounts": 2
