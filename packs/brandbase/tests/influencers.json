            "org": "co-a",
            "slug": "leo-lee",
            "name": "Leo Lee",
            "category": "food",
            "status": "active",
            "accounts": [
              {
                "platform": "instagram",
                "handle": " @Mr_AgLeoOLeo ",
                "followers": 36600
              },
              {
                "platform": "tiktok",
                "handle": "mr_agleooleo",
                "followers": 2791
              }
