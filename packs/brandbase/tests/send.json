  "cases": [
    {
      "name": "makes one job per account and is scheduled, not posted, until each account says so",
      "steps": [
        {
          "sql": "insert into brandbase.connections (brand_id, key, status) values ('casa', 'ig', 'connected'), ('casa', 'tt', 'connected')"
        },
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00",
            "caption": "Fresh pasta tonight.",
            "media": [
              {
                "src": "/videos/pasta.mp4",
                "kind": "video"
              }
            ],
            "draft": {
              "privacy": "Everyone",
              "promo": {
                "on": false
              }
            }
          }
        },
        {
          "call": "post.schedule",
          "input": {
            "brand": "casa",
            "id": "p1",
            "when": "slot"
          },
          "expect": {
            "result": {
              "stage": "scheduled",
              "jobs": [
                {
                  "channel": "ig",
                  "runAt": "2026-10-08T10:00:00.000Z"
                },
                {
                  "channel": "tt",
                  "runAt": "2026-10-08T10:00:00.000Z"
                }
              ]
            }
          }
        }
      ]
    },
