    {
      "name": "answers a repeated send with its first answer, so a double click makes no second job",
      "steps": [
        {
          "sql": "insert into brandbase.connections (brand_id, key, status) values ('casa', 'ig', 'connected'), ('casa', 'tt', 'connected')"
        },
        {
          "call": "post.create_draft",
          "input": {
            "brand": "casa",
            "id": "p1",
            "format": "reel",
            "hook": "Pasta night",
            "day": "2026-10-08",
            "time": "18:00",
            "caption": "Fresh pasta tonight.",
            "media": [
              {
                "src": "/videos/pasta.mp4",
                "kind": "video"
              }
            ],
            "draft": {
              "privacy": "Everyone",
              "promo": {
                "on": false
              }
            }
          }
        },
        {
          "call": "post.schedule",
          "input": {
            "brand": "casa",
            "id": "p1",
            "when": "slot"
          },
          "key": "send-abcdefgh"
        },
        {
          "call": "post.schedule",
          "input": {
            "brand": "casa",
            "id": "p1",
            "when": "slot"
          },
          "expect": {
            "same": true
          },
          "key": "send-abcdefgh"
        },
        {
          "sql": "select count(*)::int as n from brandbase.post_jobs",
          "expect": {
            "rows": [
              {
                "n": 2
              }
            ]
          }
        }
      ]
    },
