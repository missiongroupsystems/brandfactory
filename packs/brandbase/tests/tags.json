{
  "name": "tags",
  "now": "2026-11-24T04:00:00Z",
  "as": "member",
  "cases": [
    {
      "name": "a member adds and removes a creator's tags, in one spelling, and the list and the read answer them",
      "steps": [
        {
          "call": "influencer.tag_add",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": " #Italian   Food "
          },
          "expect": {
            "result": {
              "id": "00000000-0000-4000-8000-00000000a001",
              "tags": ["italian food"]
            }
          }
        },
        {
          "call": "influencer.tag_add",
          "as": "owner",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "wine"
          },
          "expect": {
            "result": {
              "tags": ["italian food", "wine"]
            }
          }
        },
        {
          "call": "influencer.tag_add",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "Wine"
          },
          "expect": {
            "result": {
              "tags": ["italian food", "wine"]
            }
          }
        },
        {
          "call": "influencer.list",
          "expect": {
            "result": [
              {
                "name": "Ana Lee",
                "tags": ["italian food", "wine"]
              }
            ]
          }
        },
        {
          "call": "influencer.read",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001"
          },
          "expect": {
            "result": {
              "tags": ["italian food", "wine"],
              "notes": "Cooks at home."
            }
          }
        },
        {
          "call": "influencer.tag_drop",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "WINE"
          },
          "expect": {
            "result": {
              "tags": ["italian food"]
            }
          }
        },
        {
          "call": "influencer.tag_add",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "!!"
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "call": "influencer.tag_add",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "a tag that is far too long to be one"
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "call": "influencer.tag_drop",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "-"
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION"
          }
        },
        {
          "sql": "select tags_team, tags_hidden, tagged_at, updated_at = created_at as unedited from brandbase.influencers where slug = 'ana-lee'",
          "expect": {
            "rows": [
              {
                "tags_team": ["italian food"],
                "tags_hidden": ["wine"],
                "tagged_at": null,
                "unedited": true
              }
            ]
          }
        },
        {
          "call": "influencer.tag_add",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "wine"
          },
          "expect": {
            "result": {
              "tags": ["italian food", "wine"]
            }
          }
        },
        {
          "sql": "select tags_hidden from brandbase.influencers where slug = 'ana-lee'",
          "expect": {
            "rows": [
              {
                "tags_hidden": []
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a creator of another company is not found, and a stranger or a deactivated account reaches no one",
      "steps": [
        {
          "call": "influencer.tag_add",
          "input": {
            "id": "00000000-0000-4000-8000-00000000b001",
            "tag": "steak"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "influencer.tag_drop",
          "input": {
            "id": "00000000-0000-4000-8000-00000000b001",
            "tag": "steak"
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "influencer.tag_add",
          "as": "b-owner",
          "input": {
            "id": "00000000-0000-4000-8000-00000000b001",
            "tag": "steak"
          },
          "expect": {
            "result": {
              "tags": ["steak"]
            }
          }
        },
        {
          "call": "influencer.list",
          "expect": {
            "length": 1,
            "result": [
              {
                "name": "Ana Lee",
                "tags": []
              }
            ]
          }
        },
        {
          "call": "influencer.tag_due",
          "input": {
            "limit": 10
          },
          "expect": {
            "length": 1,
            "result": [
              {
                "id": "00000000-0000-4000-8000-00000000a001"
              }
            ]
          }
        },
        {
          "call": "influencer.tag_due",
          "as": "stranger",
          "input": {
            "limit": 10
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "influencer.tag_due",
          "as": "gone",
          "input": {
            "limit": 10
          },
          "expect": {
            "status": 403,
            "code": "ACCOUNT_DEACTIVATED"
          }
        },
        {
          "call": "influencer.tag_set",
          "input": {
            "id": "00000000-0000-4000-8000-00000000b001",
            "source": "9afb9ddb3f5fcf58f47b51344d2c8081",
            "tags": ["wine"]
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "call": "influencer.bio_set",
          "input": {
            "id": "00000000-0000-4000-8000-00000000b001",
            "bio": "Steak."
          },
          "expect": {
            "status": 404,
            "code": "NOT_FOUND"
          }
        },
        {
          "sql": "select tags_team, tags_ai, bio from brandbase.influencers where slug = 'ben-tan'",
          "expect": {
            "rows": [
              {
                "tags_team": ["steak"],
                "tags_ai": [],
                "bio": null
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a creator has at most 20 tags of the team's own; one they have already is no new one",
      "steps": [
        {
          "sql": "update brandbase.influencers set tags_team = array(select 'tag ' || n from generate_series(1, 20) n) where slug = 'ana-lee'"
        },
        {
          "call": "influencer.tag_add",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "tag": "wine"
