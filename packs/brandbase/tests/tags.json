                "tagDue": true
              }
            ]
          }
        },
        {
          "call": "influencer.tag_set",
          "input": {
            "id": "00000000-0000-4000-8000-00000000a001",
            "source": "9b26dea98f7085e3de642a161718a79e",
            "tags": ["family", "wine", "home cooking", "Budget Eats"]
          },
          "expect": {
            "result": {
              "tags": ["budget eats", "home cooking"]
            }
          }
        },
        {
          "sql": "select tags_team, tags_ai, tags_hidden, tags_source from brandbase.influencers where slug = 'ana-lee'",
          "expect": {
