    {
      "name": "keeps the DM and TikTok sources on and off like any connection",
      "steps": [
        {
          "call": "connection.set",
          "input": {
            "brand": "casa",
            "key": "moodboard-dm",
            "status": "connected"
          }
        },
        {
          "call": "connection.set",
          "input": {
            "brand": "casa",
            "key": "moodboard-tt",
            "status": "connected"
          }
        },
        {
          "call": "connection.set",
          "input": {
            "brand": "casa",
            "key": "moodboard-tt",
            "status": "off"
          },
          "expect": {
            "result": {
              "key": "moodboard-tt",
              "status": "off"
            }
          }
        },
        {
          "sql": "select key, status from brandbase.connections where key like 'moodboard%' order by key",
          "expect": {
            "rows": [
              {
                "key": "moodboard-dm",
                "status": "connected"
              },
              {
                "key": "moodboard-tt",
                "status": "off"
              }
            ]
          }
        }
      ]
