{
  "name": "influencer.read",
  "description": "One person on the roster, as influencer.list answers each.",
  "input": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    }
  },
  "before": ["influencer.found"],
  "returns": "one",
  "sql": "select brandbase.influencer_json(:id::uuid) as result"
}
